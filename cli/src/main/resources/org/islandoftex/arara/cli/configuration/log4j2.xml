<Configuration>
    <Appenders>
        <!--
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
        -->
        <!-- the timestamp spells the date numerically on purpose: a month
             name would follow the default locale of the machine and break
             the invariant that the log file reads the same everywhere -->
        <File name="File" append="${ctx:araraAppend:-false}" fileName="${ctx:araraLogFile}">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level - %msg%n" />
        </File>
    </Appenders>

    <Loggers>
        <Logger name="org.zeroturnaround.exec" level="OFF"/>
        <Root level="ALL">
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
